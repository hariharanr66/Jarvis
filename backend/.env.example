# JARVIS Backend Environment Configuration Template

# Server & CORS Settings
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=https://your-jarvis-app.vercel.app
ALLOWED_ORIGINS=https://your-jarvis-app.vercel.app

# Database Settings (SQLite for local dev, PostgreSQL / Supabase URL for production)
DATABASE_URL=sqlite:///./jarvis.db

# AI Provider Settings
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# API Keys (Backend environment variables only - NEVER commit secrets)
GEMINI_API_KEY=your_gemini_api_key_here
